{
  "name": "@lucataco/pistack",
  "version": "0.2.0",
  "private": true,
  "description": "pstack for pi 1.4: Lauren Tan's poteto-mode workflows with sticky mode, native subagents, worktree isolation, per-role models, and bounded loops.",
  "type": "module",
  "license": "MIT",
  "author": "lucataco",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lucataco/pistack.git"
  },
  "homepage": "https://github.com/lucataco/pistack#readme",
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "skills",
    "subagents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "pstack",
    "cursor-team-kit",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "upstream.lock.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./pstack/skills",
      "./cursor-team-kit/skills"
    ]
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "check": "npm run check:generated && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
